<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FollowMotors.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mediator obligatorio: MediatR orquesta Controller -> Validator -> Handler -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <!-- Validators obligatorios, ejecutados en el pipeline antes del Handler -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FollowMotors.Domain\FollowMotors.Domain.csproj" />
  </ItemGroup>
</Project>
